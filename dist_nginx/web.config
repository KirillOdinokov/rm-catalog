<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="Legacy product" stopProcessing="true">
          <match url="^product/(.+?)/?$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Legacy category" stopProcessing="true">
          <match url="^category/(.+?)/?$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Legacy shop paging" stopProcessing="true">
          <match url="^shop/page/[0-9]+/?$" />
          <action type="Redirect" url="/shop" redirectType="Permanent" />
        </rule>
        <rule name="Legacy filters" stopProcessing="true">
          <match url="^iznosostoykost-po-taberu/.*$" />
          <action type="Redirect" url="/shop" redirectType="Permanent" />
        </rule>
        <rule name="Legacy misc" stopProcessing="true">
          <match url="^(cart-2|checkout-2|wishlist|my-account|shilka-1|shilka-2b)/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Calculators" stopProcessing="true">
          <match url="^calculators/?$" />
          <action type="Redirect" url="/kalkulyatory" redirectType="Permanent" />
        </rule>
        <rule name="Trim trailing slash" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Extensionless to html" stopProcessing="true">
          <match url="^(?!assets/)([^./]+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
